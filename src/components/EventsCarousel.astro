---
// Карусель мероприятий: используется для международных ивентов и мероприятий в России.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import Carousel from './Carousel.astro';
import Icon from './Icon.astro';
import { getImage } from '../lib/images';
import { t, ui, formatDate, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  collection: 'eventsInternational' | 'eventsRussia';
  id: string;
  eyebrow: string;
  title: string;
  lead: string;
}
const { lang, collection, id, eyebrow, title, lead } = Astro.props;
const u = ui[lang];
const events = await getCollection(collection);
const icon = { linkedin: 'linkedin', telegram: 'telegram', vk: 'vk', site: 'globe' } as const;
---

<section id={id} class="section overflow-hidden" aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <SectionHeader eyebrow={eyebrow} title={title} lead={lead} id={`${id}-title`} />
    <Carousel lang={lang} label={title}>
      {
        events.map(({ data }) => {
          const cover = getImage(data.image);
          const name = t(data.title, lang);
          return (
            <div class="swiper-slide">
              <article class="card flex h-full flex-col overflow-hidden">
                <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-br from-brand/25 via-brand/10 to-surface-2">
                  {cover ? (
                    <Image src={cover} alt={name} widths={[400, 640, 800]} sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw" class="h-full w-full object-cover" loading="lazy" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-brand/60">
                      <Icon name={icon[data.source]} size={44} />
                    </div>
                  )}
                  {data.placeholder && <span class="placeholder-badge absolute top-3 left-3 bg-surface">{u.placeholder}</span>}
                </div>
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
                    <span class="inline-flex items-center gap-1"><Icon name="pin" size={14} />{t(data.location, lang)}</span>
                    {data.date && <span class="inline-flex items-center gap-1"><Icon name="calendar" size={14} /><time datetime={data.date}>{formatDate(data.date, lang)}</time></span>}
                  </div>
                  <h3 class="mt-3 text-lg leading-snug font-semibold">{name}</h3>
                  <p class="mt-2 line-clamp-3 text-sm text-muted">{t(data.description, lang)}</p>
                  <p class="mt-3 text-sm"><span class="font-semibold">{u.myRole}:</span> <span class="text-muted">{t(data.role, lang)}</span></p>
                  <div class="mt-auto flex flex-wrap gap-2 pt-5">
                    {data.url ? (
                      <a href={data.url} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-sm" data-goal={`click_post_${data.source}`}>
                        <Icon name={icon[data.source]} size={16} />
                        {u.viewPost[data.source]}
                      </a>
                    ) : (
                      <span class="inline-flex min-h-9 items-center gap-2 text-sm text-muted">
                        <Icon name={icon[data.source]} size={16} />
                        {u.postSoon}
                      </span>
                    )}
                    {data.embedUrl && (
                      <button type="button" class="btn-ghost btn-sm" data-open-viewer data-kind="embed" data-src={data.embedUrl} data-title={name}>
                        <Icon name="eye" size={16} />
                        {u.openPost}
                      </button>
                    )}
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </Carousel>
  </div>
</section>
