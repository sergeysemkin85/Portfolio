---
// Одно модальное окно на страницу: PDF, картинки и LinkedIn-embed.
// Закрывается по Esc, крестику и клику вне окна.
import Icon from './Icon.astro';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const u = ui[Astro.props.lang];
---

<dialog id="viewer" aria-labelledby="viewer-title" class="m-auto h-[92dvh] max-h-none w-[min(64rem,94vw)] max-w-none overflow-hidden rounded-2xl border border-line bg-surface p-0 text-ink">
  <div class="flex h-full flex-col">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3 sm:px-5">
      <h2 id="viewer-title" data-viewer-title class="mr-auto truncate text-sm font-semibold sm:text-base" style="font-family:var(--font-sans)"></h2>
      <a data-viewer-download hidden class="btn-primary btn-sm" href="#">
        <Icon name="download" size={16} />{u.download}
      </a>
      <button type="button" data-viewer-close class="btn-ghost btn-sm !w-9 !px-0" aria-label={u.close}>
        <Icon name="close" size={18} />
      </button>
    </div>
    <div data-viewer-body class="min-h-0 flex-1 bg-surface-2 p-2 sm:p-4"></div>
  </div>
</dialog>
