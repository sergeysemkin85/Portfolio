---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/images';
import { ui, type Lang, sectionNo, sectionBg } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang];
const publicDir = path.resolve('public');
const exists = (p: string) => fs.existsSync(path.join(publicDir, p));

const certificates = (await getCollection('certificates')).map(({ id, data }) => {
  const file = data.file ?? `/certificates/${id}.pdf`;
  const isImage = /\.(png|jpe?g|webp)$/i.test(file);
  const previewPath = isImage ? file : `/certificates/previews/${id}.webp`;
  return {
    id,
    ...data,
    file,
    kind: isImage ? 'image' : 'pdf',
    hasFile: exists(file),
    preview: exists(previewPath) ? previewPath : '',
  };
});
const categories = ['AI', 'Marketing', 'Management', 'Education', 'Language'].filter((c) => certificates.some((x) => x.category === c));
---

<section id="certifications" class:list={['section', sectionBg('certifications')]} aria-labelledby="certifications-title">
  <div class="container-x">
    <SectionHeader eyebrow={sectionNo('certifications')} title={u.certsTitle} lead={u.certsLead} id="certifications-title" />

    <div class="reveal mt-10 flex flex-wrap gap-2" role="group" aria-label={lang === 'ru' ? 'Фильтр по категориям' : 'Filter by category'} data-cert-filter>
      <button type="button" data-filter="all" aria-pressed="true" class="btn-ghost btn-sm aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-brand-ink">{u.all}</button>
      {
        categories.map((c) => (
          <button type="button" data-filter={c} aria-pressed="false" class="btn-ghost btn-sm aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-brand-ink">
            {c}
          </button>
        ))
      }
    </div>

    <ul class="mt-6 grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-3 xl:grid-cols-5">
      {
        certificates.map((c) => {
          const title = c.title[lang];
          return (
            <li data-cert-category={c.category} class="reveal">
              <article class="card group flex h-full flex-col overflow-hidden">
                <div class="relative aspect-[4/3] overflow-hidden border-b border-line bg-surface-2">
                  {c.preview ? (
                    <img src={withBase(c.preview)} alt="" loading="lazy" decoding="async" width="400" height="300" class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
                  ) : (
                    <div class="flex h-full flex-col items-center justify-center gap-2 text-muted">
                      <Icon name="file" size={36} />
                      <span class="placeholder-badge">{u.placeholder}</span>
                    </div>
                  )}
                  <span class="absolute top-2 left-2 rounded-full bg-bg/90 px-2 py-0.5 text-[0.7rem] font-semibold">{c.category}</span>
                </div>
                <div class="flex flex-1 flex-col p-4">
                  <h3 class="text-[0.95rem] leading-snug font-semibold [overflow-wrap:anywhere] hyphens-auto" style="font-family:var(--font-sans)">{title}</h3>
                  <p class="mt-1 text-sm text-muted">
                    {c.org[lang]} · {c.year}
                  </p>
                  <div class="mt-auto pt-3">
                    {c.hasFile ? (
                      <button
                        type="button"
                        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline"
                        data-open-viewer
                        data-src={withBase(c.file)}
                        data-kind={c.kind}
                        data-title={`${title} — ${c.org[lang]}`}
                        data-download="true"
                        data-download-goal="download_certificate"
                      >
                        <Icon name="eye" size={16} />
                        {u.open}
                      </button>
                    ) : (
                      <span class="text-sm text-muted">{u.fileSoon}</span>
                    )}
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
