---
import { Image, getImage as optimize } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { getImage, withBase } from '../lib/images';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang];
const items = await Promise.all(
  (await getCollection('creatives')).map(async ({ id, data }) => {
    const img = getImage(data.image)!;
    // Крупная версия для просмотра в модальном окне
    const large = await optimize({ src: img, width: Math.min(img.width, 1600), format: 'webp', quality: 82 });
    return { id, ...data, img, large: large.src };
  }),
);
// Видео выводятся широким блоком над сеткой, остальное — в сетке
const videos = items.filter((c) => c.video);
const grid = items.filter((c) => !c.video);
---

<section id="creatives" class="section" aria-labelledby="creatives-title">
  <div class="container-x">
    <SectionHeader eyebrow="12" title={u.creativesTitle} lead={u.creativesLead} id="creatives-title" />
    {
      videos.map((v) => (
        <figure class="reveal relative left-1/2 mt-12 w-screen max-w-[1600px] -translate-x-1/2 sm:px-6 lg:px-10">
          <div class="relative aspect-video w-full overflow-hidden bg-black sm:rounded-2xl" data-video-frame>
            <button
              type="button"
              class="group absolute inset-0 block h-full w-full"
              data-video-facade
              data-src={v.video}
              data-title={v.title[lang]}
              data-goal="play_video"
              aria-label={(lang === 'ru' ? 'Смотреть видео: ' : 'Watch video: ') + v.title[lang]}
            >
              <Image src={v.img} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width:1280px) 1200px, 100vw" class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100" loading="lazy" />
              <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-black/60 via-transparent to-transparent">
                <span class="flex h-20 w-20 items-center justify-center rounded-full bg-white/90 text-accent shadow-2xl transition-transform group-hover:scale-110 sm:h-24 sm:w-24">
                  <svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
                </span>
              </span>
            </button>
          </div>
          <figcaption class="mx-auto mt-4 max-w-7xl px-4 text-lg font-semibold sm:px-0 sm:text-xl">{v.title[lang]}</figcaption>
        </figure>
      ))
    }
    <ul class="mt-12 columns-2 gap-3 sm:gap-4 md:columns-3 xl:columns-4">
      {
        grid.map((c) => {
          const title = c.title[lang];
          const isPdf = Boolean(c.file);
          const isVideo = Boolean(c.video);
          return (
            <li class="reveal mb-3 break-inside-avoid sm:mb-4">
              <button
                type="button"
                class="group relative block w-full overflow-hidden rounded-xl border border-line bg-surface text-left"
                data-open-viewer
                data-kind={isVideo ? 'embed' : isPdf ? 'pdf' : 'image'}
                data-src={isVideo ? c.video : isPdf ? withBase(c.file!) : c.large}
                data-title={title}
                data-download={isPdf ? 'true' : 'false'}
                data-download-goal="download_file"
                data-goal={isVideo ? 'play_video' : undefined}
              >
                <Image src={c.img} alt={title} widths={[300, 480, 640]} sizes="(min-width:1280px) 22vw, (min-width:768px) 30vw, 46vw" class="w-full transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
                {isVideo && (
                  <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center">
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur transition-transform group-hover:scale-110">
                      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
                    </span>
                  </span>
                )}
                <span class="absolute inset-x-0 bottom-0 flex items-end gap-2 bg-gradient-to-t from-black/80 to-transparent p-3 pt-10 text-xs leading-snug font-medium text-white sm:text-sm">
                  {isPdf && <Icon name="file" size={16} class="shrink-0" />}
                  {title}
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
